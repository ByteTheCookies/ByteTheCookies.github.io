---
import type { GetStaticPaths } from "astro";
import Pagination from "../../../components/control/Pagination.astro";
import PostPage from "../../../components/PostPage.astro";
import { PAGE_SIZE } from "../../../constants/constants";
import MainGridLayout from "../../../layouts/MainGridLayout.astro";
import { getSortedNews } from "../../../utils/content-utils";
import { getNewsUrlBySlug } from "../../../utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allNews = await getSortedNews();
	if (allNews.length <= PAGE_SIZE) return [];
	return paginate(allNews, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const len = page.data.length;
---

<MainGridLayout title="News" description="News">
    <PostPage page={page} getEntryUrl={getNewsUrlBySlug} />
    <Pagination
        class="mx-auto onload-animation"
        page={page}
        firstPagePath="/news/"
        pagePath="/news/page/"
        style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
    />
</MainGridLayout>
